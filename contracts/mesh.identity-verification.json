{
  "schema_version": "1.3.0",
  "system": "goreecloud-mesh",
  "trusted_issuer": "goreecloud-identity",
  "trusted_audience": "goreecloud-mesh",
  "identity_profile": "goreecloud-identity.mesh-service-token.v1",
  "identity_contract": {
    "repository": "GoreeCloud/goreecloud-identity",
    "path": "contracts/mesh-service-token.v1.json"
  },
  "identity_issuer": {
    "repository": "GoreeCloud/goreecloud-identity",
    "implementation": "goreecloud_identity/mesh_service_token.py",
    "native_authority": true,
    "transitional_authentik_compatibility_module": "authentik/goreecloud/mesh_service_token.py",
    "transitional_jwks_view": "authentik/goreecloud/mesh_service_token_views.py",
    "tests": "tests/goreecloud/test_mesh_service_token.py",
    "runtime_issuer_implemented": true,
    "jwks_generation_implemented": true,
    "private_key_storage_integrated": false,
    "jwks_endpoint_deployed": false,
    "live_service_issuance_deployed": false
  },
  "verification_adapter": {
    "implementation": "internal/trust/identity_jwt.go",
    "runtime_configuration": "cmd/mesh/main.go",
    "signature_algorithm": "RS256",
    "protected_header_type_required": "JWT",
    "unsupported_critical_headers_rejected": true,
    "alternate_or_embedded_key_source_headers_rejected": ["jku", "jwk", "x5u", "x5c"],
    "key_source": "configured GoreeCloud Identity JWKS only",
    "kid_required": true,
    "issuer_validation": true,
    "audience_validation": true,
    "expiry_validation": true,
    "not_before_validation": true,
    "issued_at_validation": true,
    "maximum_token_lifetime_seconds": 900,
    "clock_skew_seconds": 60,
    "service_subject_binding": true,
    "scope_extraction": "space-delimited scope claim",
    "unknown_signing_key_refresh": true,
    "fail_closed_without_runtime_configuration": true
  },
  "live_acceptance": {
    "command": "cmd/identity-acceptance",
    "source_harness_implemented": true,
    "source_harness_tests_implemented": true,
    "requires_exact_mesh_revision": true,
    "requires_exact_identity_revision": true,
    "requires_deployed_jwks_url": true,
    "requires_live_identity_issued_service_token": true,
    "token_file_must_be_owner_only": true,
    "required_service_id_must_match": true,
    "required_scopes_must_match": true,
    "unauthenticated_negative_control_required": true,
    "credential_may_appear_in_evidence": false,
    "private_key_material_may_appear_in_evidence": false,
    "evidence_file_mode": "0600",
    "live_identity_verifier_acceptance": false
  },
  "principal_requirements": {
    "service_id_required": true,
    "issuer_required": true,
    "subject_required_for_evidence_producers": true,
    "issuer_must_equal": "goreecloud-identity",
    "required_scope_must_be_present": true
  },
  "evidence_delivery_requirements": {
    "producer_service_id_must_equal_envelope_producer": true,
    "write_scope": "mesh.evidence.write",
    "read_scope": "mesh.evidence.read",
    "cross_producer_impersonation": "reject"
  },
  "fail_closed_conditions": [
    "identity verifier unavailable",
    "credential verification fails",
    "signature or signing key is invalid",
    "protected header type is missing or is not JWT",
    "unsupported critical protected headers are present",
    "credential attempts to select or embed an alternate verification key source",
    "issuer or audience is invalid",
    "temporal claims are invalid",
    "service subject does not match service_id",
    "principal is structurally invalid",
    "required scope is absent",
    "evidence producer does not match verified service identity"
  ],
  "deployment_boundary": "The native GoreeCloud Identity token issuer/JWKS authority and Mesh verifier are implemented, and Mesh contains a source-controlled live acceptance command. Mesh now fails closed on ambiguous protected-header profiles and does not honor token-selected or embedded key sources. The current Authentik surface is transitional compatibility/integration only. Production acceptance still requires Identity-managed durable private-key storage, a deployed approved JWKS endpoint, deployed service-token issuance, execution of the live acceptance command with a genuine Identity-issued credential, live key-rotation evidence, and end-to-end producer delivery evidence.",
  "production_acceptance": false
}
