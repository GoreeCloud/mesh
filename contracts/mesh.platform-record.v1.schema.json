{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goreecloud.com/mesh/platform-record.v1.schema.json",
  "title": "GoreeCloud Mesh Platform Record v1",
  "description": "Authority-preserving normalized representation of a GoreeCloud Platform Contract v0.2 declaration and its computed conformance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "component", "platform_systems", "health", "recovery", "portability", "conformance", "observed_at"],
  "properties": {
    "schema": {"const": "goreecloud.mesh.platform-record.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "contract_schema_version", "authority_transfer"],
      "properties": {
        "repository": {"type": "string", "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contract_schema_version": {"const": "0.2"},
        "authority_transfer": {"const": false}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product_name", "kind", "repository", "lifecycle", "version", "supported_platforms"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "product_name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["application", "service"]},
        "repository": {"type": "string", "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"},
        "lifecycle": {"enum": ["concept", "experimental", "development", "release-candidate", "stable", "deprecated", "retired"]},
        "version": {"type": "string", "minLength": 1},
        "supported_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "type", "required"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "type": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "platform_systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "identity", "wardveil_security", "privacy_shield", "everkeep", "mesh", "glaze_ui"],
      "properties": {
        "manager": {"$ref": "#/$defs/platformSystem"},
        "identity": {"$ref": "#/$defs/platformSystem"},
        "wardveil_security": {"$ref": "#/$defs/platformSystem"},
        "privacy_shield": {"$ref": "#/$defs/platformSystem"},
        "everkeep": {"$ref": "#/$defs/platformSystem"},
        "mesh": {"$ref": "#/$defs/platformSystem"},
        "glaze_ui": {"$ref": "#/$defs/platformSystem"}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_state", "health_state", "readiness"],
      "properties": {
        "runtime_state": {"type": "string", "minLength": 1},
        "health_state": {"type": "string", "minLength": 1},
        "readiness": {"type": "string", "minLength": 1}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_status", "restore_status"],
      "properties": {
        "backup_status": {"$ref": "#/$defs/verificationState"},
        "restore_status": {"$ref": "#/$defs/verificationState"},
        "last_verified_restore": {"type": "string", "format": "date-time"}
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["export_status"],
      "properties": {
        "export_status": {"$ref": "#/$defs/verificationState"},
        "formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_result", "computed_result", "stable_eligible", "evaluator_repository", "evaluator_revision", "evaluated_at"],
      "properties": {
        "declared_result": {"$ref": "#/$defs/conformanceState"},
        "computed_result": {"$ref": "#/$defs/conformanceState"},
        "stable_eligible": {"type": "boolean"},
        "evaluator_repository": {"const": "GoreeCloud/GoreeCloud"},
        "evaluator_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "missing_mandatory_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "location", "producer"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "producer": {"type": "string", "minLength": 1}
        }
      }
    },
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "verificationState": {"enum": ["verified", "implemented_unverified", "required_missing", "not_applicable", "unknown"]},
    "conformanceState": {"enum": ["conformant", "nonconformant", "unverified"]},
    "platformResult": {"enum": ["applicable-conformant", "applicable-migration-required", "applicable-blocked", "applicable-nonconformant", "not-applicable-justified"]},
    "platformSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {"$ref": "#/$defs/platformResult"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
